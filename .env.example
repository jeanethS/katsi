# katsi environment configuration
# Copy this file to .env and adjust values for your environment.
# Nested settings use Pydantic's double-underscore delimiter.

# Local Ollama models
KATSI_OLLAMA__HOST=http://localhost:11434
KATSI_OLLAMA__EMBED_MODEL=bge-m3
KATSI_OLLAMA__LLM_MODEL=qwen2.5:7b
KATSI_OLLAMA__TIMEOUT=120.0

# Local data stores
KATSI_STORE__DATA_DIR=~/.katsi
KATSI_STORE__LANCEDB_TABLE=chunks
KATSI_STORE__KUZU_DB=graph

# Ingestion
KATSI_INGEST__CHUNK_TOKEN_TARGET=512
KATSI_INGEST__CHUNK_TOKEN_OVERLAP=64
KATSI_INGEST__DEDUP_SIMILARITY_THRESHOLD=0.92
KATSI_INGEST__INCLUDE_GLOBS=["**/*.md","**/*.txt","**/*.py","**/*.ts","**/*.pdf","**/*.docx"]
KATSI_INGEST__EXCLUDE_GLOBS=["**/.git/**","**/node_modules/**","**/.venv/**","**/__pycache__/**"]

# Retrieval
KATSI_RETRIEVE__TOP_K_CHUNKS=16
KATSI_RETRIEVE__TOP_K_FILES=8
KATSI_RETRIEVE__GRAPH_EXPAND_HOPS=1
KATSI_RETRIEVE__VECTOR_WEIGHT=0.6
KATSI_RETRIEVE__GRAPH_WEIGHT=0.4
KATSI_RETRIEVE__DEFAULT_CONTEXT_MAX_TOKENS=3000

# MCP tools
KATSI_MCP__ENABLE_ANSWER_TOOL=false

# Synthesis: return_only, local, cloud, or auto
KATSI_SYNTH__BACKEND=return_only
KATSI_SYNTH__ALLOW_PER_CALL_OVERRIDE=true
KATSI_SYNTH__LOCAL__MODEL=qwen2.5:7b
KATSI_SYNTH__LOCAL__MAX_TOKENS=800

# Cloud synthesis (optional; used only by cloud/auto modes)
KATSI_SYNTH__CLOUD__PROVIDER=anthropic
KATSI_SYNTH__CLOUD__MODEL=claude-sonnet-4-20250514
KATSI_SYNTH__CLOUD__API_KEY_ENV=ANTHROPIC_API_KEY
KATSI_SYNTH__CLOUD__ENABLE_PROMPT_CACHING=true
KATSI_SYNTH__CLOUD__MAX_TOKENS=1024
ANTHROPIC_API_KEY=

# Automatic synthesis escalation
KATSI_SYNTH__AUTO__ESCALATE_WHEN_FILES_GTE=4
KATSI_SYNTH__AUTO__ESCALATE_WHEN_TOKENS_GTE=2500
KATSI_SYNTH__AUTO__ESCALATE_ON_INTENTS=["compare","contrast","synthesize","across","difference"]
KATSI_SYNTH__AUTO__FALLBACK_TO_LOCAL_IF_CLOUD_UNAVAILABLE=true

# Frontend API origin. Leave empty to use the current origin.
VITE_API_BASE_URL=
